{
  "name": "labs-wallet",
  "version": "1.0.0",
  "description": "Labs Wallet — XRPL desktop wallet with auto-sign for the Labs Platform.",
  "main": "main.js",
  "author": "Labs Platform",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect=5858",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "argon2": "^0.40.3",
    "electron-store": "^8.2.0",
    "keytar": "^7.9.0",
    "uuid": "^9.0.1",
    "ws": "^8.18.0",
    "xrpl": "^4.0.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "extends": null,
    "appId": "com.labs.wallet",
    "productName": "Labs Wallet",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.finance"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Finance"
    }
  }
}
